@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Class="code-block">
    <div class="code-block-header">
        <div>
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <MudText Typo="Typo.subtitle2">@Title</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(Caption))
            {
                <MudText Typo="Typo.caption" Class="sub-text">@Caption</MudText>
            }
        </div>
        <div class="code-block-actions">
            @if (!string.IsNullOrWhiteSpace(Language))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@Language</MudChip>
            }
            <MudTooltip Text="Copy snippet">
                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                               Size="Size.Small"
                               Color="Color.Secondary"
                               OnClick="CopyAsync" />
            </MudTooltip>
        </div>
    </div>
    <pre><code>@Code</code></pre>
</MudPaper>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Caption { get; set; }
    [Parameter] public string Language { get; set; } = "csharp";

    private async Task CopyAsync()
    {
        await JsRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Code);
        Snackbar.Add("Snippet copied", Severity.Success);
    }
}
