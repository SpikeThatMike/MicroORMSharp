<MudPaper Elevation="0" Class="example-card" id="@Example.Id">
    <div class="example-card-header">
        <div>
            <MudText Typo="Typo.h6" HtmlTag="h2">@Example.Title</MudText>
            <MudText Typo="Typo.body2" Class="sub-text">@Example.Summary</MudText>
        </div>
        <div class="example-card-tags">
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                @Example.Category
            </MudChip>
        </div>
    </div>

    @if (Example.Highlights.Length > 0)
    {
        <ul class="example-highlights">
            @foreach (var highlight in Example.Highlights)
            {
                <li>@highlight</li>
            }
        </ul>
    }

    <CodeBlock Code="@Example.Code" Title="@Example.CodeTitle" Language="@Example.Language" />
</MudPaper>

@code {
    [Parameter, EditorRequired] public DocumentationExample Example { get; set; } = default!;
}
