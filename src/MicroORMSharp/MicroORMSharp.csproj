<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <PackageId>MicroORMSharp</PackageId>
    <Description>ORM built on Dapper with CRUD operations, query builder, class joins, and optional table operations.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MicroORMSharp.SQLGenerator\MicroORMSharp.SqlGenerator.csproj" />
  </ItemGroup>

</Project>
